{
  \"version\": 2,
  \"routes\": [
    { \"src\": \"/api/(.*)\", \"dest\": \"/api/index.py\" },
    { \"src\": \"/(.*)\",    \"dest\": \"/public/\" }
  ],
  \"env\": {
    \"VERTX_SESSION_SECRET\": \"@vertx-session-secret\",
    \"VERTX_COOKIE_SECURE\": \"@vertx-cookie-secure\",
    \"SUPABASE_URL\": \"@supabase-url\",
    \"SUPABASE_KEY\": \"@supabase-key\"
  }
}
